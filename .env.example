PORT=8124
BIND_HOST=127.0.0.1

# Safe default: no basket writes unless this is explicitly false.
BRIDGE_DRY_RUN=true

# Optional, used by `npm run test:ha` and webhook payloads that only include a uid.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
TODO_ENTITY=todo.geoff_squiggle_org_shopping_list

# Optional. Lets open-supermarkets retry a rejected Sainsbury's session headlessly.
# Fresh logins may still need interactive MFA.
SAINSBURYS_EMAIL=
SAINSBURYS_PASSWORD=
SAINSBURYS_STORE_NUMBER=0560

STATE_FILE=./data/state.json
FAVOURITES_LIMIT=12
SEARCH_LIMIT=12
AUTO_COMPLETE_TODO=false

# Optional JSON file. Keys are shopping-list terms; values are Sainsbury's
# product IDs or arrays of product IDs in priority order.
PREFERRED_PRODUCTS_FILE=./config/preferred-products.json
